{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "test -n \"$WEB_EXT_API_KEY\" && test -n \"$WEB_EXT_API_SECRET\" || (echo 'WEB_EXT_API_KEY and WEB_EXT_API_SECRET must be set to publish to addons.mozilla.org' && exit 1)",
        "prepareCmd": "npm run build && npm run zip",
        "publishCmd": "npm run zip:source && npx web-ext sign --channel listed --source-dir dist/firefox --upload-source-code myga-source.zip --approval-timeout 0"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "myga-chrome.zip", "label": "Chrome extension (v${nextRelease.version})" },
          { "path": "myga-firefox.zip", "label": "Firefox add-on (v${nextRelease.version})" }
        ]
      }
    ]
  ]
}
