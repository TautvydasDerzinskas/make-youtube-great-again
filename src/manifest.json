{
  "manifest_version": 3,
  "name": "Make YouTube™ great again",
  "description": "Browser extension adding new functionality to YouTube™ experience",
  "version": "0.0.0",
  "author": "Tautvydas Derzinskas",
  "homepage_url": "https://tautvydasderzinskas.github.io/make-youtube-great-again/",
  "action": {
    "default_icon": {
      "19": "icons/icon_19x19.png",
      "38": "icons/icon_38x38.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon_16x16.png",
    "48": "icons/icon_48x48.png",
    "96": "icons/icon_96x96.png",
    "128": "icons/icon_128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "page.bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/bars/*.css",
        "images/bars/*"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ]
}
