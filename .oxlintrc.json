{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc"
  ],
  "env": {
    "browser": true,
    "webextensions": true,
    "es2022": true
  },
  "globals": {
    "__BROWSER__": "readonly",
    "__MYGA__": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.scss",
          "**/*.css",
          "**/popup.meta"
        ]
      }
    ],
    "no-underscore-dangle": "off",
    "import/no-named-as-default": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/assets"
  ]
}
