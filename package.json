{
  "name": "make-youtube-great-again",
  "version": "1.6.0",
  "private": true,
  "description": "Browser extension adding new functionality to YouTube™ experience",
  "homepage": "https://tautvydasderzinskas.github.io/make-youtube-great-again/",
  "type": "module",
  "scripts": {
    "dev": "rspack build --watch --mode development --env browser=chrome",
    "dev:firefox": "rspack build --watch --mode development --env browser=firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "rspack build --env browser=chrome",
    "build:firefox": "rspack build --env browser=firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "cd dist/chrome && bestzip ../../myga-chrome.zip *",
    "zip:firefox": "cd dist/firefox && bestzip ../../myga-firefox.zip *",
    "zip:source": "git archive --format=zip --output=myga-source.zip HEAD",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bestzip": "^4.0.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "css-loader": "^7.1.5",
    "cz-customizable": "^7.5.4",
    "husky": "^9.1.7",
    "oxlint": "^1.85.0",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.1",
    "semantic-release": "^25.0.9",
    "semantic-release-chrome": "^3.2.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  },
  "keywords": [
    "Chrome",
    "Firefox",
    "Youtube",
    "Extension",
    "JavaScript",
    "TypeScript",
    "React"
  ],
  "author": {
    "name": "Tautvydas Derzinskas",
    "email": "tautvydasuk@gmail.com",
    "url": "https://www.tautvydas.info"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TautvydasDerzinskas/make-youtube-great-again.git"
  },
  "bugs": {
    "url": "https://github.com/TautvydasDerzinskas/make-youtube-great-again/issues",
    "email": "tautvydasuk+myga@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "config/cz-customizable/base.cjs"
    }
  }
}
